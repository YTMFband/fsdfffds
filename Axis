            local Amount = Axis.Combat.SilentAim.PulseAmmout
            local BaseFov = Axis.Combat.SilentAim.FovRadius

            dt__Pulse = dt__Pulse + (deltaTime * Speed)
            SilentAim__Fov.Radius = BaseFov + (math.cos(dt__Pulse) * Amount)
        else
            SilentAim__Fov.Radius = Axis.Combat.SilentAim.FovRadius
        end

    else
        if SilentAim__Fov.Visible then
            SilentAim__Fov.Visible = false
