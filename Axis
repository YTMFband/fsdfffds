function GetClosetTarget()
    local Target
    local PlayerTarget 
    local ClosetPosition = Axis.Combat.SilentAim.FovRadius
    local MouseLocation = UserInputService:GetMouseLocation()

    for i = 1, #Script.Players do
        local Player = Script.Players[i]
        local Char = Player.Character
        if not Char then continue end

        local hrp = Char:FindFirstChild("HumanoidRootPart")
        local head = Char:FindFirstChild("Head")

        if not hrp or not head then continue end
        local Direction = (hrp.Position - L_Player.Character.HumanoidRootPart.Position).Magnitude

        if Axis.Combat.SilentAim.DownCheck and IsPlayerDown(Player)  then
            continue
        end
        if Axis.Combat.SilentAim.WallCheck and not WallCheck(head) then
            continue
        end
        if Axis.Combat.SilentAim.FriendCheck and IsFriendWith(L_Player, Player) then
            continue
        end
        if Axis.Miscs.WhiteListSettings.Enabled and Axis.Miscs.WhiteListSettings.PlayersOnWhiteList[Player.Name] then
            continue
        end
        if Direction > Axis.Combat.SilentAim.MaxDistance then
            continue
        end

        if Axis.Combat.SilentAim.NearestPart then
            for _, partName in ipairs(Axis.Combat.SilentAim.NearestPartWhitelist) do
                local part = Char:FindFirstChild(partName)
                if not part then continue end

                local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
                if not onScreen then continue end

                local dist = (MouseLocation - Vector2.new(pos.X, pos.Y)).Magnitude
                if dist < ClosetPosition then
                    ClosetPosition = dist
                    Target = part
                    PlayerTarget = Player
                end
            end
        else
            local targetPartName = Axis.Combat.SilentAim.TargetPart
            local targetPart = Char:FindFirstChild(targetPartName)
            if not targetPart then continue end


            local pos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
            local LastPositon = MouseLocation
            if Axis.Combat.SilentAim.TargetPriority == 'Closest to Center' then
                LastPositon = Camera.ViewportSize / 2
            end

            local dist = (LastPositon - Vector2.new(pos.X, pos.Y)).Magnitude
            if dist < ClosetPosition then
                ClosetPosition = dist
                Target = targetPart
                PlayerTarget = Player
            end
        end
    end

    return Target, PlayerTarget
end

