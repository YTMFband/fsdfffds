Users.PlayerAdded:Connect(function(player)
    if player ~= L_Player then
        repeat
            task.wait(0.1)
        until player.Character ~= nil

        OnPlayerAdded(player)
        OnVisualsAdded(player)


        if not table.find(Script.ListPlayersWhitelist, player.Name) then
            table.insert(Script.ListPlayersWhitelist, player.Name)
        end
        Options.PlayerList:SetValues(Script.ListPlayersWhitelist)

        if Axis.Miscs.WhiteListSettings.AutoWhiteListOnJoin and not Script.LastLoggedPlayer[player.UserId] == true then
            if not Axis.Miscs.WhiteListSettings.PlayersOnWhiteList[player.Name] then
                Axis.Miscs.WhiteListSettings.PlayersOnWhiteList[player.Name] = true
            end

            Options.PlayerList:SetValue(Axis.Miscs.WhiteListSettings.PlayersOnWhiteList)
        end
    end
end)

Users.PlayerRemoving:Connect(function(player)
    if player ~= L_Player then
        OnPlayerRemove(player)
        OnVisualRemove(player)
        local Userid = player.UserId
        if not Script.LastLoggedPlayer[Userid] then
            Script.LastLoggedPlayer[Userid] = true
        end
        if table.find(Script.ListPlayersWhitelist, player.Name) then
            table.remove(Script.ListPlayersWhitelist, table.find(Script.ListPlayersWhitelist, player.Name))
        end
        Options.PlayerList:SetValues(Script.ListPlayersWhitelist)
        if Axis.Miscs.WhiteListSettings.PlayersOnWhiteList[player.Name] then
            Axis.Miscs.WhiteListSettings.PlayersOnWhiteList[player.Name] = nil
        end
        Options.PlayerList:SetValue(Axis.Miscs.WhiteListSettings.PlayersOnWhiteList)

    end
end)

Options.PlayerList:SetValues(Script.ListPlayersWhitelist)
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if NewKeybindCooldown then return end
    if input.KeyCode == Axis.Combat.SilentAim.Keybind then
        Axis.Combat.SilentAim.Enabled = not Axis.Combat.SilentAim.Enabled
        Toggles.SilentAimEnabled:SetValue(Axis.Combat.SilentAim.Enabled)
        if Axis.Combat.SilentAim.SelectPriority == 'Toggled' then
            if Axis.Combat.SilentAim.Enabled == true then
                local Ignore, Player = GetClosetTarget()
                Script.TargetSettings.Player = Player
            end
        end
    elseif input.KeyCode == Axis.Miscs.GunMacro.Keybind and Axis.Miscs.GunMacro.Enabled and DebounceGunMacro == false  then
        local L_Character : Model = L_Player.Character 
        if not L_Character then
            return
        end

        L_Character['Humanoid']:UnequipTools() 
        DebounceGunMacro = true
        for Gun, Boolean in next, Axis.Miscs.GunMacro.GunList do
            local FindGun:Tool = L_Character:FindFirstChild(Gun) or L_Player.Backpack:FindFirstChild(Gun)

            if Axis.Miscs.GunMacro.AmmoCheck then
                if FindGun:FindFirstChild('Ammo').Value == 0 then
                continue
                end
            end

            if FindGun.Parent == L_Player.Backpack then
                FindGun.Parent = L_Character
                if Axis.Miscs.GunMacro.AutoShoot then
                    FindGun:Activate()
                end
                task.wait(Axis.Miscs.GunMacro.Cooldown)
                FindGun.Parent = L_Player.Backpack
            end
        end

        DebounceGunMacro = false
    end
end)


