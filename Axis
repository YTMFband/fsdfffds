function DrawFov(Thickness, NumSide, Radius, Color)
    local Default = Drawing.new('Circle')
    Default.Color = Color
    Default.Thickness = Thickness
    Default.Visible = false
    Default.Transparency = 1
    Default.Radius = Radius
    Default.NumSide = NumSide
    return Default
end

function DrawLine(Thickness,Color)
    local Default = Drawing.new("Line")
    Default.Visible = false
    Default.Color = Color
    Default.Thickness = Thickness
    Default.Transparency = 1
    return Default
end


function DrawQuad(Thickness, Color)
    local quad = Drawing.new("Quad")
    quad.Visible = false
    quad.PointA = Vector2.new(0,0)
    quad.PointB = Vector2.new(0,0)
    quad.PointC = Vector2.new(0,0)
    quad.PointD = Vector2.new(0,0)
    quad.Color = Color
    quad.Filled = false
    quad.Thickness = Thickness
    quad.Transparency = 1
    quad.Filled  = false
    return quad
end

function DrawSquare(Thickness, Color)
    local Square = Drawing.new("Square")
    Square.Visible = false
    Square.Position = Vector2.zero
    Square.Size = Vector2.zero
    Square.Color = Color
    Square.Thickness = Thickness
    Square.Transparency = 1
    Square.Filled  = false
    return Square
    
end

function DrawText(DefaultSize, Color, transparency)
    local text = Drawing.new("Text")
    text.Visible = false
    text.Text = ""
    text.Position = Vector2.new(0, 0)
    text.Color = Color
    text.Size = DefaultSize
    text.Center = true
    text.Transparency = transparency
    text.Outline = true
    return text
end


