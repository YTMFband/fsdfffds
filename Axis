RunService.Heartbeat:Connect(function(deltaTime)
    if tick() - LastUpdateTick > 0.04 then
        if ( Axis.Combat.SilentAim.Enabled and Axis.Combat.SilentAim.SelectPriority == 'Free For All')  then
            local part, plr = GetClosetTarget()
            Script.TargetSettings.Part = part
        elseif (Axis.Combat.SilentAim.Enabled and Script.TargetSettings.Player and Axis.Combat.SilentAim.SelectPriority == 'Toggled') then
            if Script.TargetSettings.Player.Parent == Users then
                local HookCharacter = Script.TargetSettings.Player.character
                local HookPart
                if (HookCharacter and HookCharacter:FindFirstChild('HumanoidRootPart')) then
                    if Axis.Combat.SilentAim.NearestPart then
                    else
                        local GetPartName = Axis.Combat.SilentAim.TargetPart
                        local PartName = HookCharacter:FindFirstChild(GetPartName)
                        if PartName then
                            HookPart = PartName
                        end
                    end

                    Script.TargetSettings.Part = HookPart
                end
            end
        elseif (Axis.Combat.SilentAim.Enabled == false and Script.TargetSettings.Player or  Script.TargetSettings.Part) then
            Script.TargetSettings.Player = nil
            Script.TargetSettings.Part = nil
        end
        LastUpdateTick = tick()
    end


    if (Axis.Miscs.LegitUtility.AutoBuyArmor) then
        if tick() - LastArmorFire >= Axis.Miscs.LegitUtility.AutoBuyCooldown then
            for index, item in next, Script.ShopItems do
                local Name = item.Name

                if not item:FindFirstChild('Head') then
                    continue
                end

                if not item:FindFirstChild('ClickDetector') then
                    continue
                end
                if not string.match(Name, "%[Full Armor%]") then
                    continue
                end
    
                local Head = item:FindFirstChild('Head')
                local ClickDetector = item:FindFirstChild('ClickDetector')

                if L_Player.Character and L_Player.Character:FindFirstChild("HumanoidRootPart") and L_Player.Character:FindFirstChild('BodyEffects').Armor.Value < 200 then
                    local Dist = (L_Player.Character:FindFirstChild("HumanoidRootPart").Position - Head.Position).Magnitude
                    if Dist <= Axis.Miscs.LegitUtility.AutoBuyDistance then
                        fireclickdetector(ClickDetector)
                        RunService.RenderStepped:Wait()
                        LastArmorFire = tick()
                    end
                end
            end
        end
    end

    if ( Axis.Miscs.LegitUtility.AutoBuyFoods) then
        if tick() - LastFoodFire >= Axis.Miscs.LegitUtility.AutoBuyCooldown then
            for index, item in next, Script.ShopItems do
                local Name = item.Name

                if not item:FindFirstChild('Head') then
                    continue
                end

                if not item:FindFirstChild('ClickDetector') then
                    continue
                end

                if not Axis.Miscs.LegitUtility.FoodsList[string.match(Name, "^(%S+)")] then
                    continue
                end

                local Head = item:FindFirstChild('Head')
                local ClickDetector = item:FindFirstChild('ClickDetector')

                if L_Player.Character and L_Player.Character:FindFirstChild("HumanoidRootPart") then
                    local Dist = (L_Player.Character:FindFirstChild("HumanoidRootPart").Position - Head.Position).Magnitude
                    if Dist <= Axis.Miscs.LegitUtility.AutoBuyDistance then
                        fireclickdetector(ClickDetector)
                        RunService.RenderStepped:Wait()
                        LastFoodFire = tick()
                    end
                end
            end
        end
    end

    if (Axis.Miscs.LegitUtility.AutoEat and L_Player.Character ~= nil) then
        local Tool = L_Player.Character:FindFirstChildWhichIsA('Tool')
        local CanEat = if Tool ~= nil then if Tool.Name == '[Chicken]' or Tool.Name == '[Cranberry]' or Tool.Name == '[Hamburger]' or Tool.Name == '[Pizza]'or Tool.Name == '[Stim]'or Tool.Name == '[Taco]' then true else false else false
        if CanEat then
            Tool:Activate()
        end
    end

    if Axis.Visual.Lighting.Fog then
        Lighting.FogStart = Axis.Visual.Lighting.FogStart
        Lighting.FogEnd = Axis.Visual.Lighting.FogEnd
        Lighting.FogColor = Axis.Visual.Lighting.FogColor
    end
    
    if Axis.Visual.Lighting.Ambiend then
