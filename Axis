for index, value in pairs(Users:GetPlayers()) do
    OnPlayerAdded(value)
    if value ~= L_Player then
        AddPlayerQuad(value)
        PlayerAddLine(value)

        if not table.find(Script.ListPlayersWhitelist, value.Name) then
            table.insert(Script.ListPlayersWhitelist, value.Name)
        end

    end
end

Users.PlayerAdded:Connect(function(player)

    OnPlayerAdded(player)
    AddPlayerQuad(player)
    PlayerAddLine(player)

    if player ~= L_Player then
        if not table.find(Script.ListPlayersWhitelist, player.Name) then
            table.insert(Script.ListPlayersWhitelist, player.Name)
        end
        Options.PlayerList:SetValues(Script.ListPlayersWhitelist)

        if Axis.Miscs.WhiteListSettings.AutoWhiteListOnJoin and not Script.LastLoggedPlayer[player.UserId] == true then
            if not Axis.Miscs.WhiteListSettings.PlayersOnWhiteList[player.Name] then
                Axis.Miscs.WhiteListSettings.PlayersOnWhiteList[player.Name] = true
            end

            Options.PlayerList:SetValue(Axis.Miscs.WhiteListSettings.PlayersOnWhiteList)
        end
    end
end)

Users.PlayerRemoving:Connect(function(player)
    OnPlayerRemove(player)
    OnPlayerRemoveQuad(player)
    local Userid = player.UserId

    if not Script.LastLoggedPlayer[Userid] then
        Script.LastLoggedPlayer[Userid] = true
    end

    if player ~= L_Player then
        if table.find(Script.ListPlayersWhitelist, player.Name) then
            table.remove(Script.ListPlayersWhitelist, table.find(Script.ListPlayersWhitelist, player.Name))
        end
        Options.PlayerList:SetValues(Script.ListPlayersWhitelist)
        if Axis.Miscs.WhiteListSettings.PlayersOnWhiteList[player.Name] then
            Axis.Miscs.WhiteListSettings.PlayersOnWhiteList[player.Name] = nil
        end
        Options.PlayerList:SetValue(Axis.Miscs.WhiteListSettings.PlayersOnWhiteList)

    end
end)

Options.PlayerList:SetValues(Script.ListPlayersWhitelist)


