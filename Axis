    end

    if Axis.Visual.Lighting.OutDoorAmbiend then
        Lighting.OutdoorAmbient = Axis.Visual.Lighting.OutDoorAmbiendColor
    end

    if Axis.Visual.Lighting.ColorShift_Bottom then
        Lighting.ColorShift_Bottom = Axis.Visual.Lighting.ColorShift_BottomColor
    end

    if Axis.Visual.Lighting.ColorShift_Top then
        Lighting.ColorShift_Top = Axis.Visual.Lighting.ColorShift_TopColor
    end

    if Axis.Visual.Lighting.Shadow then
        Lighting.ShadowColor = Axis.Visual.Lighting.ShadowColor
        Lighting.ShadowSoftness = Axis.Visual.Lighting.ShadowSlider
    end

    if Axis.Visual.Lighting.Brightness then
        Lighting.Brightness = Axis.Visual.Lighting.BrightnessVl3
    end

    Lighting.LightingStyle = Enum.LightingStyle[tostring(Axis.Visual.Lighting.LightingStyle)]
    Lighting.Technology = Enum.Technology[tostring(Axis.Visual.Lighting.Technology)]


end)



local last__chance__shoot = 0
local last__chance__hit = false

local TB__Connection = nil;
local Last__Shoot__tb = 0;

local Hit__Chance = function()
    local currentTime = tick()

    if currentTime - last__chance__shoot > 0.05 then
        last__chance__shoot = currentTime
        local chance = Axis.Combat.SilentAim.HitChance or 100
        last__chance__hit = math.random(1, 100) <= chance
    end
    
    return last__chance__hit
end

local oldGetAim = GunHandler.GetAim
GunHandler.GetAim = function(p17, ...)

    if Axis.Combat.SilentAim.Enabled and Script.TargetSettings.Part then
        if Hit__Chance() then
            local NewHookPosition = Script.TargetSettings.Part.Position
            local origin = p17
            local direction = (NewHookPosition - origin).Unit
            local distance = (NewHookPosition - origin).Magnitude
            
            return direction, distance
        end
    end

    return oldGetAim(p17, ...)
end

local hookgame
hookgame = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
    local args = {...}
    local method = getnamecallmethod()
    if not checkcaller() and method == 'FireServer' and self == MainRemoteEvent then
        if args[1] == 'ShootGun' then
            if Axis.Miscs.GunRange.Revolver or Axis.Miscs.GunRange.TacticalShotgun or Axis.Miscs.GunRange.DoubleBarrelSG then
                local GetToolName = args[2]
                local FullyName = GetToolName.Parent.Name
                if type(args[8]) == 'number' then
                    args[8] = Script.SavedDataGun[FullyName].SavedRange
                end
            end


            return hookgame(self, unpack(args))
        end
    end

    return hookgame(self, ...)
end))



