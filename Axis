UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if NewKeybindCooldown then return end
    if input.KeyCode == Axis.Combat.SilentAim.Keybind then
        Axis.Combat.SilentAim.Enabled = not Axis.Combat.SilentAim.Enabled
        Toggles.SilentAimEnabled:SetValue(Axis.Combat.SilentAim.Enabled)
        if Axis.Combat.SilentAim.SelectPriority == 'Toggled' then
            if Axis.Combat.SilentAim.Enabled == true then
                local Ignore, Player = GetClosetTarget()
                Script.TargetSettings.Player = Player
            end
        end
    end


end)


