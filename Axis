            if not char then continue end

            local HRP = char:WaitForChild('HumanoidRootPart', 1)
            local hitnox = HRP:FindFirstChild("ExpandHitbox")

            hitnox.Size = Vector3.new(X,Y,Z)
        end
    end

    local on__update__bl4 = function(X,Y,Z)
        for i = 1, #Players do
            local Player = Players[i]
            local char = Player.Character
            if not char then continue end

            local HRP = char:WaitForChild('HumanoidRootPart', 1)
            local hitnox = HRP:FindFirstChild("ExpandHitbox")

            hitnox.CanQuery =  getgenv()["Snipe"].Triggerbot.HitboxEnabled

        end
    end


    for _, Player in ipairs(Users_:GetPlayers()) do
        if Player ~= game:GetService("Players").LocalPlayer then
            if Player.Character then
                task.spawn(on__Character__Added, Player.Character)
            end

            Player.CharacterAdded:Connect(function(char)
                task.spawn(on__Character__Added, char)
            end)
        end
    end

    Users_.PlayerAdded:Connect(function(plr)
        if plr.Character then
            task.spawn(on__Character__Added, Player.plr.Character)
        end

        plr.CharacterAdded:Connect(function(char)
            task.spawn(on__Character__Added, char)
        end)
    end)

    Creat__Con(Signals['On__Hitbox__vl31'], on__update__bl4)
    Creat__Con(Signals['On__Hitbox__tb'], on__update__size)
end


