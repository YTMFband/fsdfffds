    local on__Character__Added = function(char)
        local hrp = char:WaitForChild("HumanoidRootPart", 5)
        if not hrp then return end

        
        if hrp:FindFirstChild("ExpandHitbox") then return end

        local hitbox = Instance.new("Part")
        hitbox.Name = "ExpandHitbox"
        hitbox.Size = Vector3.new(getgenv()["Snipe"].Triggerbot.HitboxX, getgenv()["Snipe"].Triggerbot.HitboxY, getgenv()["Snipe"].Triggerbot.HitboxZ)
        hitbox.CFrame = hrp.CFrame 
        hitbox.Transparency = 1
        hitbox.Color = Color3.fromRGB(255, 0, 0)
        hitbox.Material = Enum.Material.ForceField
        
        hitbox.CanCollide = false
        hitbox.CanTouch = false
        hitbox.CanQuery = false 
        hitbox.Anchored = false
        hitbox.Massless = true
        
        local weld = Instance.new("WeldConstraint")
        weld.Part0 = hitbox
        weld.Part1 = hrp
        weld.Parent = hitbox
        table.insert(MainModule.Ignored, hitbox)
        hitbox.Parent = hrp
    end

    local on__update__size = function(X,Y,Z)
        for i = 1, #Players do
            local Player = Players[i]
