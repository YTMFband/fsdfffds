local old
old = hookmetamethod(game, "__index", function(self, property)
    if self == L_Mouse and not checkcaller() then
        if property == "Target" or property == "target" then
            if getgenv()["Snipe"].SilentAim.SelectionAim then
                return getgenv()["Snipe"].SilentAim.SelectionAim
            end
        end
        if property == "Hit" or property == "hit" then
            if getgenv()["Snipe"].SilentAim.SelectionAim then
                return getgenv()["Snipe"].SilentAim.SelectionAim.CFrame
            end
        end
    end
    return old(self, property)
end)

do
